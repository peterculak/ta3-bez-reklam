{
  "manifest_version": 3,
  "name": "TA3 – Open in VLC",
  "version": "1.0.0",
  "description": "Adds an 'Open in VLC' button to TA3 video pages.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://embed.livebox.cz/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.ta3.com/*", "https://ta3.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
