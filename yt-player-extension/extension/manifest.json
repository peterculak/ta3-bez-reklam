{
  "manifest_version": 3,
  "name": "YouTube – vlastný prehrávač",
  "version": "0.1.0",
  "description": "Nahradí prehrávač YouTube vlastným (cez yt-dlp, bez reklám) a pridá tlačidlo Open in VLC.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
